# Optional. Without a key Consentry runs its on-device "Autopilot" planner (no LLM, fully offline reasoning).
ANTHROPIC_API_KEY=
# Model used when a key is present. Defaults to claude-opus-5-5.
CONSENTRY_MODEL=claude-opus-5-5
# Effort for the agent loop: low | medium | high
CONSENTRY_EFFORT=low
# Port for the gateway + dashboard
PORT=8787
